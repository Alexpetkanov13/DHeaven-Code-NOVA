{
  "name": "@nova/desktop",
  "productName": "DHeaven Code NOVA",
  "version": "0.1.0",
  "description": "DHeaven Code: NOVA — Build Beyond Limits.",
  "author": "DHeaven",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "pnpm build:renderer && pnpm build:main",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src e2e",
    "test": "vitest run",
    "e2e": "playwright test",
    "dist:win": "pnpm build && electron-builder --win --x64",
    "dist:linux": "pnpm build && electron-builder --linux AppImage tar.gz"
  },
  "dependencies": {},
  "devDependencies": {
    "@nova/ipc-contract": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "zod": "^4.6.6"
  },
  "desktopName": "dheaven-code-nova.desktop"
}
