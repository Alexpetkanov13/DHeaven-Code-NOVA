{
 "comments": {
  "lineComment": "#"
 },
 "brackets": [
  [
   "{",
   "}"
  ],
  [
   "[",
   "]"
  ],
  [
   "(",
   ")"
  ]
 ],
 "autoClosingPairs": [
  {
   "open": "{",
   "close": "}"
  },
  {
   "open": "[",
   "close": "]"
  },
  {
   "open": "(",
   "close": ")"
  },
  {
   "open": "\"",
   "close": "\"",
   "notIn": [
    "string",
    "comment"
   ]
  },
  {
   "open": "%",
   "close": "%",
   "notIn": [
    "comment"
   ]
  }
 ],
 "surroundingPairs": [
  {
   "open": "{",
   "close": "}"
  },
  {
   "open": "(",
   "close": ")"
  },
  {
   "open": "\"",
   "close": "\""
  },
  {
   "open": "%",
   "close": "%"
  }
 ],
 "onEnterRules": [
  {
   "beforeText": "^\\s*[^#\\s][^#]*:\\s*(#.*)?$",
   "action": {
    "indent": "indent"
   }
  }
 ]
}