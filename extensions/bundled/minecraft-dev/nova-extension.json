{
  "manifestVersion": 1,
  "name": "minecraft-dev",
  "publisher": "dheaven",
  "displayName": "Minecraft Developer Pack",
  "description": "First-party, bundled. Fabric mod / Paper plugin project templates (versions resolved from official Fabric/PaperMC sources at generation time); fabric.mod.json, plugin.yml, pack.mcmeta and model JSON validation; Minecraft run tasks with explicit EULA consent; Skript highlighting/snippets/indentation (SYNTAX ONLY: no Skript validation or addon awareness). Contains no Mojang assets.",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "nova": "^0.1.0"
  },
  "contributes": {
    "projectTemplates": [
      {
        "id": "fabric-mod",
        "label": "Minecraft: Fabric mod",
        "description": "Fabric Loom project (Minecraft 26.1+, unobfuscated, no mappings) with main + client entrypoints and Fabric API.",
        "path": "templates/fabric-mod",
        "resolver": "fabric",
        "wrapper": "templates/_gradle-wrapper"
      },
      {
        "id": "paper-plugin",
        "label": "Minecraft: Paper plugin",
        "description": "Paper plugin (plugin.yml) with the run-paper Gradle plugin for a local test server.",
        "path": "templates/paper-plugin",
        "resolver": "paper",
        "wrapper": "templates/_gradle-wrapper"
      }
    ],
    "languages": [
      {
        "id": "json",
        "extensions": [
          ".mcmeta"
        ]
      },
      {
        "id": "skript",
        "aliases": [
          "Skript (syntax only)",
          "Skript"
        ],
        "extensions": [
          ".sk"
        ],
        "configuration": "language-configuration.skript.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "fabric.mod.json"
        ],
        "schema": "schemas/fabric.mod.json.schema.json"
      },
      {
        "fileMatch": [
          "pack.mcmeta"
        ],
        "schema": "schemas/pack.mcmeta.schema.json"
      },
      {
        "fileMatch": [
          "assets/*/models/**/*.json"
        ],
        "schema": "schemas/model.schema.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "plugin.yml",
          "paper-plugin.yml"
        ],
        "schema": "schemas/plugin.yml.schema.json"
      }
    ],
    "snippets": [
      {
        "language": "json",
        "path": "snippets/minecraft-json.json"
      },
      {
        "language": "skript",
        "path": "snippets/skript.json"
      }
    ],
    "gradleRunTasks": [
      {
        "view": "Minecraft",
        "plugin": "net.fabricmc.fabric-loom",
        "label": "Fabric (Loom)",
        "tasks": [
          {
            "name": "runClient",
            "label": "Run client",
            "requiresEula": false,
            "runDir": "run"
          },
          {
            "name": "runServer",
            "label": "Run server",
            "requiresEula": true,
            "runDir": "run"
          }
        ]
      },
      {
        "view": "Minecraft",
        "plugin": "fabric-loom",
        "label": "Fabric (Loom, legacy plugin id)",
        "tasks": [
          {
            "name": "runClient",
            "label": "Run client",
            "requiresEula": false,
            "runDir": "run"
          },
          {
            "name": "runServer",
            "label": "Run server",
            "requiresEula": true,
            "runDir": "run"
          }
        ]
      },
      {
        "view": "Minecraft",
        "plugin": "xyz.jpenilla.run-paper",
        "label": "Paper (run-paper)",
        "tasks": [
          {
            "name": "runServer",
            "label": "Run server",
            "requiresEula": true,
            "runDir": "run"
          }
        ]
      }
    ],
    "grammars": [
      {
        "language": "skript",
        "format": "monarch",
        "path": "syntaxes/skript.monarch.json"
      }
    ]
  }
}