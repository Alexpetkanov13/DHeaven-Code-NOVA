{
 "displayName": "Skript (syntax only)",
 "defaultToken": "",
 "ignoreCase": true,
 "tokenPostfix": ".sk",
 "keywords": [
  "if",
  "else",
  "else if",
  "loop",
  "while",
  "set",
  "add",
  "remove",
  "delete",
  "clear",
  "reset",
  "send",
  "broadcast",
  "message",
  "give",
  "teleport",
  "cancel",
  "uncancel",
  "stop",
  "return",
  "exit",
  "continue",
  "wait",
  "make",
  "execute",
  "kill",
  "spawn",
  "drop",
  "shoot",
  "push",
  "heal",
  "damage",
  "ignite",
  "extinguish",
  "apply",
  "enchant",
  "disenchant",
  "equip",
  "open",
  "close",
  "log",
  "play",
  "strike",
  "toggle",
  "to",
  "from",
  "of",
  "in",
  "at",
  "with",
  "by",
  "for",
  "as",
  "is",
  "are",
  "was",
  "were",
  "isn't",
  "aren't",
  "not",
  "neither",
  "nor",
  "has",
  "have",
  "contains",
  "contain",
  "and",
  "or",
  "than",
  "event",
  "trigger",
  "then",
  "parse",
  "times",
  "every",
  "without",
  "named",
  "each",
  "all",
  "console",
  "sender",
  "player",
  "players",
  "victim",
  "attacker",
  "loop-player",
  "loop-value",
  "loop-index",
  "loop-entity",
  "loop-block",
  "loop-number",
  "arg",
  "argument",
  "event-block",
  "event-entity",
  "event-item",
  "event-player",
  "event-world",
  "event-location",
  "item",
  "block",
  "entity",
  "world",
  "location",
  "the",
  "a",
  "an",
  "true",
  "false",
  "yes",
  "no",
  "on",
  "off",
  "none",
  "nothing",
  "null"
 ],
 "structures": [
  "command",
  "function",
  "options",
  "variables",
  "aliases",
  "every",
  "on",
  "import",
  "using"
 ],
 "brackets": [
  {
   "open": "(",
   "close": ")",
   "token": "delimiter.parenthesis"
  },
  {
   "open": "[",
   "close": "]",
   "token": "delimiter.square"
  }
 ],
 "tokenizer": {
  "root": [
   [
    "^\\s*#.*$",
    "comment"
   ],
   [
    "\\s+#(?![0-9a-fA-F]{6}\\b).*$",
    "comment"
   ],
   [
    "^(on)(\\s+)([^:#]+)(:)",
    [
     "keyword.structure",
     "white",
     "type.event",
     "delimiter"
    ]
   ],
   [
    "^(command)(\\s+)(/?[A-Za-z0-9_:.-]+)",
    [
     "keyword.structure",
     "white",
     "entity.name.command"
    ]
   ],
   [
    "^(function)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
    [
     "keyword.structure",
     "white",
     "entity.name.function"
    ]
   ],
   [
    "^(options|variables|aliases)(\\s*)(:)",
    [
     "keyword.structure",
     "white",
     "delimiter"
    ]
   ],
   [
    "^(every)(\\s+)",
    [
     "keyword.structure",
     "white"
    ]
   ],
   [
    "^(\\s+)(trigger|permission message|permission|description|usage|executable by|aliases|cooldown message|cooldown bypass|cooldown storage|cooldown|prefix)(\\s*)(:)",
    [
     "white",
     "keyword.entry",
     "white",
     "delimiter"
    ]
   ],
   [
    "\\{",
    "variable",
    "@variable"
   ],
   [
    "\\\"",
    "string",
    "@string"
   ],
   [
    "%",
    "variable.expression",
    "@expression"
   ],
   [
    "<[a-z_]+>|&[0-9a-fk-or]",
    "string.escape"
   ],
   [
    "\\b\\d+(\\.\\d+)?\\s*(ticks?|seconds?|minutes?|hours?|days?|real (seconds?|minutes?|hours?|days?)|minecraft (seconds?|minutes?|hours?|days?))\\b",
    "number.time"
   ],
   [
    "\\b\\d+(\\.\\d+)?\\b",
    "number"
   ],
   [
    "\\b(arg|argument)-\\d+\\b",
    "variable.predefined"
   ],
   [
    "::",
    "operator"
   ],
   [
    "[A-Za-z][A-Za-z0-9_'-]*",
    {
     "cases": {
      "@keywords": "keyword",
      "@default": "identifier"
     }
    }
   ],
   [
    "[(\\[]",
    "@brackets"
   ],
   [
    "[)\\]]",
    "@brackets"
   ],
   [
    "[=<>!+\\-*/^]+",
    "operator"
   ],
   [
    "[:,]",
    "delimiter"
   ]
  ],
  "string": [
   [
    "\\\"\\\"",
    "string.escape"
   ],
   [
    "%",
    "variable.expression",
    "@expression"
   ],
   [
    "<[a-z_#0-9]+>|&[0-9a-fk-or]|\u00a7[0-9a-fk-or]",
    "string.escape"
   ],
   [
    "[^\\\"%<&\u00a7]+",
    "string"
   ],
   [
    "[<&\u00a7]",
    "string"
   ],
   [
    "\\\"",
    "string",
    "@pop"
   ]
  ],
  "expression": [
   [
    "%",
    "variable.expression",
    "@pop"
   ],
   [
    "\\{",
    "variable",
    "@variable"
   ],
   [
    "\\\"",
    "string",
    "@string"
   ],
   [
    "[^%{\\\"]+",
    "variable.expression"
   ]
  ],
  "variable": [
   [
    "\\{",
    "variable",
    "@push"
   ],
   [
    "%",
    "variable.expression",
    "@expression"
   ],
   [
    "\\}",
    "variable",
    "@pop"
   ],
   [
    "[^{}%]+",
    "variable"
   ]
  ]
 }
}